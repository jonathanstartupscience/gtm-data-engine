# Secrets — never commit
.env
.env.*
!.env.example

# Build output
dist/
*.tsbuildinfo

# Deps
node_modules/

# Data (may contain PII; regenerable)
data/*.csv
data/*.xlsx
!data/.gitkeep

# Logs / OS
*.log
.DS_Store
# Scratch / one-off runner files (any leading-underscore script or data drop)
_*.ts
_*.mjs
_*.json
*.tmp.ts
