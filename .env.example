# Copy to .env and fill in. NEVER commit .env. Set the same vars in Railway → Variables.

# --- Database (Railway provides DATABASE_URL automatically when you add Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/gtm_data_engine

# --- Core enrichment/verification stack (from the ESO run; ROTATE before prod) ---
HUBSPOT_TOKEN=
AIRSCALE_API_KEY=
BOUNCER_API_KEY=

# --- Discovery ---
OCEAN_API_KEY=
# ORIGAMI_API_KEY=   # deferred until plan upgrade

# --- Activation (cold email + LinkedIn) ---
EMAILBISON_API_KEY=
EMAILBISON_BASE_URL=https://dedi.emailbison.com/api   # instance-specific; change to your instance
HEYREACH_API_KEY=

# --- Auth (Clerk — same instance as other internal apps) ---
# Backend verifies sessions against this JWKS (no secret key needed). If unset, app runs OPEN.
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Frontend (Vite) publishable key. If unset, the UI runs without a login gate.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE

# --- App ---
PORT=3000
NODE_ENV=development
